# Configuration du site FACES Magazine.
# Copier ce fichier en `.env` à la racine du projet et compléter les valeurs.
# Le fichier `.env` ne doit JAMAIS être versionné.

# --- Général ----------------------------------------------------------------
# Générer une clé avec :
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=facesmagazine.ch,www.facesmagazine.ch
DJANGO_CSRF_TRUSTED_ORIGINS=https://facesmagazine.ch,https://www.facesmagazine.ch
# URL publique, avec le slash final (sert aux retours de paiement Stripe).
DJANGO_DOMAIN=https://www.facesmagazine.ch/

# --- Données ----------------------------------------------------------------
# Chemins absolus en production, pour que la base et les médias survivent
# à un redéploiement du code.
# DJANGO_DB_PATH=/var/lib/facesmagazine/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/facesmagazine/media

# --- E-mail -----------------------------------------------------------------
# Laisser vide en développement : les messages s'affichent dans la console.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@facesmagazine.ch
# Destinataires du formulaire de contact, séparés par des virgules.
CONTACT_RECIPIENTS=info@facesmagazine.ch

# --- Stripe -----------------------------------------------------------------
# Clé de test (sk_test_…) en développement, clé live en production.
# La clé publique (pk_…) n'est pas utilisée : la page de paiement est hébergée
# par Stripe et le site ne charge aucun script Stripe côté navigateur.
STRIPE_SECRET_KEY=
# Fourni par le tableau de bord Stripe à la création du endpoint webhook,
# ou par `stripe listen` en local. Dépend de l'URL : à régénérer à chaque
# changement de domaine.
STRIPE_WEBHOOK_SECRET=
